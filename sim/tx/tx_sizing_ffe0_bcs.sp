Bmp mp 0 V='v(vdd)-0.3*(1-v(d))'
Bmn mn 0 V='v(vdd)-0.3*v(d)'
Bqp qp 0 V='v(vdd)-0.3*(1-v(dd))'
Bqn qn 0 V='v(vdd)-0.3*v(dd)'
Xbias vdd 0 vbn bias
Xprem vdd 0 mp mn vbn pp pn predriver
Xprep vdd 0 qp qn vbn rp rn predriver
Bvbp0 vbp0 0 V='ffe*v(vbn)'
Bvbp1 vbp1 0 V='ffe*v(vbn)'
Bvbp2 vbp2 0 V='ffe*v(vbn)'
Xdrv vdd 0 pp pn rp rn vbn vbp0 vbp1 vbp2 cop con driver_ffe
Rpadp cop padp 4
Cpadp padp 0 100f
Rpadn con padn 4
Cpadn padn 0 100f
Rload padp padn 100
Bvd vd 0 V='v(padp)-v(padn)'
.param ffe=0
.ic v(vbn)=0.9
