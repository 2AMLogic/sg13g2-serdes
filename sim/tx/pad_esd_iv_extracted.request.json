{
  "engine": "ngspice",
  "netlist": "pad_esd_iv_extracted.sp",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerHBT.lib"
  },
  "corners": {
    "process": [
      {
        "name": "hbt_typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "hbt_bcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ff"
          }
        ]
      },
      {
        "name": "hbt_wcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ss"
          }
        ]
      }
    ],
    "temperature_c": [
      -40,
      27,
      125
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ]
    }
  },
  "analysis": {
    "kind": "dc",
    "args": "Vp -0.6 1.8 0.1"
  },
  "measurements": [
    {
      "name": "clamp_ext_i_m0p6_a",
      "unit": "A",
      "spice": ".meas dc clamp_ext_i_m0p6_a find i(Vp) at=-0.6"
    },
    {
      "name": "clamp_ext_i_p0p6_a",
      "unit": "A",
      "spice": ".meas dc clamp_ext_i_p0p6_a find i(Vp) at=0.6"
    },
    {
      "name": "clamp_ext_i_p1p2_a",
      "unit": "A",
      "spice": ".meas dc clamp_ext_i_p1p2_a find i(Vp) at=1.2"
    },
    {
      "name": "clamp_ext_i_p1p8_a",
      "unit": "A",
      "spice": ".meas dc clamp_ext_i_p1p8_a find i(Vp) at=1.8"
    }
  ],
  "options": {
    "stage_model_inputs": true,
    "timeout_s": 120,
    "keep_artifacts": false
  }
}
