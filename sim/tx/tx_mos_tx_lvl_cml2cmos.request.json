{
  "engine": "ngspice",
  "netlist": "tx_mos_tx_lvl_cml2cmos.sp",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "tt_typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_tt"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      },
      {
        "name": "ff_bcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ff"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_bcs"
          }
        ]
      },
      {
        "name": "ss_wcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ss"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_wcs"
          }
        ]
      },
      {
        "name": "fs_typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_fs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      },
      {
        "name": "sf_typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_sf"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          }
        ]
      }
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "2p 1e-08"
  },
  "measurements": [
    {
      "name": "out_hi",
      "unit": "V",
      "spice": ".meas tran out_hi max v(out) from=3e-09 to=1e-08"
    },
    {
      "name": "out_lo",
      "unit": "V",
      "spice": ".meas tran out_lo min v(out) from=3e-09 to=1e-08"
    },
    {
      "name": "t_high_s",
      "unit": "s",
      "spice": ".meas tran t_high_s trig v(on) val=0 rise=1 td=3e-09 targ v(on) val=0 fall=1 td=3e-09"
    },
    {
      "name": "t_period_s",
      "unit": "s",
      "spice": ".meas tran t_period_s trig v(on) val=0 rise=1 td=3e-09 targ v(on) val=0 rise=2 td=3e-09"
    },
    {
      "name": "tpd_lh_s",
      "unit": "s",
      "spice": ".meas tran tpd_lh_s trig v(din) val=0 fall=1 td=3e-09 targ v(on) val=0 rise=1 td=3e-09"
    },
    {
      "name": "tpd_hl_s",
      "unit": "s",
      "spice": ".meas tran tpd_hl_s trig v(din) val=0 rise=1 td=3e-09 targ v(on) val=0 fall=1 td=3e-09"
    },
    {
      "name": "idd_avg",
      "unit": "A",
      "spice": ".meas tran idd_avg avg par('-i(vdd)') from=3e-09 to=1e-08"
    }
  ],
  "options": {
    "stage_model_inputs": true,
    "timeout_s": 75,
    "keep_artifacts": false,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ]
  }
}
