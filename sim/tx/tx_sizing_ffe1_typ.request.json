      "spice": ".meas tran r7_rise_20_80_s trig v(vd) val=-0.04 rise=1 td=2.5n targ v(vd) val=0.04 rise=1 td=2.5n"
    },
    {
      "name": "r7_fall_80_20_s",
      "unit": "s",
      "spice": ".meas tran r7_fall_80_20_s trig v(vd) val=0.04 fall=1 td=1.3n targ v(vd) val=-0.04 fall=1 td=1.3n"
    },
    {
      "name": "idd_avg",
      "unit": "A",
      "spice": ".meas tran idd_avg avg par('-i(vdd)') from=1.5n to=8.8e-09"
