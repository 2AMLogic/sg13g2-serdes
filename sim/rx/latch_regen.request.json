{
  "engine": "ngspice",
  "netlist": "latch_regen.sp",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerHBT.lib"
  },
  "corners": {
    "process": [
      {
        "name": "hbt_typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "hbt_bcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ff"
          }
        ]
      },
      {
        "name": "hbt_wcs",
