          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ss"
          }
        ]
      }
    ],
    "temperature_c": [
      -40,
      27,
      125
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ]
    }
  },
  "analysis": {
    "kind": "tran",
    "args": "2p 3n"
  },
  "measurements": [
    {
      "name": "latch_t_regen_up",
      "unit": "s",
      "spice": ".meas tran latch_t_regen_up trig v(ck) val=0 fall=1 td=2.35n targ v(q) val=0.25 rise=1 td=2.35n",
      "limits": {
        "max": 1e-10
      }
    },
    {
      "name": "latch_t_regen_dn",
      "unit": "s",
