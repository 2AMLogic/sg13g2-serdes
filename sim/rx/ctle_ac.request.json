{
  "engine": "ngspice",
  "netlist": "ctle_ac.sp",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerHBT.lib"
  },
  "corners": {
    "process": [
      {
        "name": "hbt_typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "hbt_bcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ff"
          }
        ]
      },
      {
        "name": "hbt_wcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ss"
          }
        ]
      }
    ],
    "temperature_c": [
      -40,
      27,
      125
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ]
    }
  },
  "analysis": {
    "kind": "ac",
    "args": "lin 300 1e8 3e10"
  },
  "measurements": [
    {
      "name": "ctle_c0_g0p1g_db",
      "unit": "dB",
      "expr": "db(v(d0)[0])"
    },
    {
      "name": "ctle_c0_g2p5g_db",
      "unit": "dB",
      "expr": "db(v(d0)[24])"
    },
    {
      "name": "ctle_c0_g5g_db",
      "unit": "dB",
      "expr": "db(v(d0)[49])"
    },
    {
      "name": "ctle_c0_peak5g_db",
      "unit": "dB",
      "expr": "ctle_c0_g5g_db - ctle_c0_g0p1g_db",
      "limits": {
        "max": 1.0
      }
    },
    {
      "name": "ctle_c1_g0p1g_db",
